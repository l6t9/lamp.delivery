---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Lampcord · Native Discord, without the bloat"
  description="A lightweight, native Discord client for Mobile and Desktop built with Compose Multiplatform."
  pathname="/cord"
>
  <div class="metrosite-page">
    <!-- Navbar -->
    <header class="navbar">
      <div class="container navbar__inner">
        <div class="navbar__header">
          <a href="/cord" class="navbar__brand">
            <span>Lampcord</span>
          </a>

          <button
            id="menu-toggle"
            class="navbar__toggle"
            aria-label="Toggle navigation menu"
            aria-expanded="false"
            aria-controls="navbar-menu"
          >
            <span class="material-symbols-outlined navbar__toggle-icon">menu</span>
          </button>
        </div>

        <nav id="navbar-menu" class="navbar__links">
          <div class="navbar__links-inner">
            <a href="#showcase">Showcase</a>
            <a href="#features">Features</a>
            <a href="#faq">FAQ</a>
            <a href="https://discord.gg/uHXJJzxSD8" target="_blank" rel="noreferrer">Discord</a>
            <a href="https://github.com/l6t9/Lampcord#readme" target="_blank" rel="noreferrer">Documentation</a>
            <a href="#download" class="btn btn-filled btn-sm">
              <span class="material-symbols-outlined" style="font-size:16px">download</span>
              Download
            </a>
          </div>
        </nav>
      </div>
    </header>

    <main id="main">
      <!-- Hero Section -->
      <section class="hero">
        <div class="container">
          <div class="hero__layout">
            <div class="hero__copy">
              <h1>Native Discord, <span>without the bloat.</span></h1>

              <p class="hero__lede">
                Lightweight Discord client built with Kotlin Multiplatform.
              </p>

              <div class="hero__actions">
                <a href="#download" class="btn btn-filled">
                  <span class="material-symbols-outlined">download</span>
                  Get Lampcord
                </a>
                <a href="https://github.com/l6t9/Lampcord" target="_blank" rel="noreferrer" class="btn btn-outlined">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.73.083-.73 1.205.085 1.84 1.237 1.84 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.776.417-1.306.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12 24 5.37 18.63 0 12 0z"/></svg>
                  GitHub
                </a>
                <a href="https://discord.gg/uHXJJzxSD8" target="_blank" rel="noreferrer" class="btn btn-outlined">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20.317 4.369a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.331c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
                  Discord
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Showcase Section -->
      <section id="showcase" class="showcase">
        <div class="container">
          <div class="showcase__header">
            <div class="showcase__heading">
              <h2>Showcase</h2>
            </div>

            <div class="showcase__tabs" role="tablist" aria-label="Showcase screens">
              <button class="showcase__tab active" data-tab="chat" role="tab" aria-selected="true">
                <span class="material-symbols-outlined">chat</span>
                <span>Chat</span>
              </button>
              <button class="showcase__tab" data-tab="settings" role="tab" aria-selected="false">
                <span class="material-symbols-outlined">settings</span>
                <span>Settings</span>
              </button>
              <button class="showcase__tab" data-tab="profile" role="tab" aria-selected="false">
                <span class="material-symbols-outlined">account_circle</span>
                <span>Profile</span>
              </button>
            </div>
          </div>

          <div class="showcase__mosaic">
            <!-- Desktop Container -->
            <figcaption class="preview-tile">
              <div class="preview-tile__header">
                <div class="preview-tile__label">
                  <span class="material-symbols-outlined">desktop_windows</span>
                  <strong>Desktop</strong>
                </div>
                <span class="preview-tile__detail">Linux, Windows & macOS</span>
              </div>

              <!-- Chat Screen -->
              <div class="preview-tile__screen-wrap active" data-tab-content="chat">
                <div class="preview-tile__screen">
                  <img src="/images/lampcord.png?v=3" alt="Lampcord Desktop Preview" class="screen-img" />
                </div>
              </div>

              <!-- Settings Screen -->
              <div class="preview-tile__screen-wrap" data-tab-content="settings">
                <div class="preview-tile__screen">
                  <img src="/images/lampcord-s.png?v=3" alt="Lampcord Desktop Settings Preview" class="screen-img" />
                </div>
              </div>

              <!-- Profile Screen -->
              <div class="preview-tile__screen-wrap" data-tab-content="profile">
                <div class="preview-tile__screen">
                  <img src="/images/lampcord-p.png?v=3" alt="Lampcord Desktop Profile Preview" class="screen-img" />
                </div>
              </div>
            </figcaption>

            <!-- Mobile Container -->
            <figcaption class="preview-tile">
              <div class="preview-tile__header">
                <div class="preview-tile__label">
                  <span class="material-symbols-outlined">smartphone</span>
                  <strong>Mobile</strong>
                </div>
                <span class="preview-tile__detail">Android & iOS</span>
              </div>

              <!-- Chat Screen -->
              <div class="preview-tile__screen-wrap active" data-tab-content="chat">
                <div class="preview-tile__screen">
                  <img src="/images/lampcord-1.png?v=3" alt="Lampcord Mobile Preview" class="screen-img" />
                </div>
              </div>

              <!-- Settings Screen -->
              <div class="preview-tile__screen-wrap" data-tab-content="settings">
                <div class="preview-tile__screen">
                  <img src="/images/lampcord-s1.png?v=3" alt="Lampcord Mobile Settings Preview" class="screen-img" />
                </div>
              </div>

              <!-- Profile Screen -->
              <div class="preview-tile__screen-wrap" data-tab-content="profile">
                <div class="preview-tile__screen">
                  <img src="/images/lampcord-p1.png?v=3" alt="Lampcord Mobile Profile Preview" class="screen-img" />
                </div>
              </div>
            </figcaption>
          </div>
        </div>
      </section>

      <!-- Features Section -->
      <section id="features" class="features">
        <div class="container">
          <div class="section-header-wrap">
            <h2>Features</h2>
          </div>

          <div class="features__grid">
            <div class="features__card">
              <div class="features__top">
                <span class="material-symbols-outlined">bolt</span>
                <h3>No Electron or WebViews</h3>
              </div>
              <p>Native rendering on every platform, full Wayland support</p>
            </div>

            <div class="features__card">
              <div class="features__top">
                <span class="material-symbols-outlined">palette</span>
                <h3>Material 3 Expressive</h3>
              </div>
              <p>M3E UI, Dynamic color, and system dark/light theme integration.</p>
            </div>

            <div class="features__card">
              <div class="features__top">
                <span class="material-symbols-outlined">graphic_eq</span>
                <h3>Voice Chat</h3>
              </div>
              <p>End-to-end encrypted voice protocol with in-call controls and voice channels.</p>
            </div>

            <div class="features__card">
              <div class="features__top">
                <span class="material-symbols-outlined">tune</span>
                <h3>Customization</h3>
              </div>
              <p>Aliucord theme support, Custom font selection, UserBG/PFP, and Free Nitro emojis.</p>
            </div>

            <div class="features__card">
              <div class="features__top">
                <span class="material-symbols-outlined">chat</span>
                <h3>Messaging</h3>
              </div>
              <p>Taptap, text-replace, message logger, account switcher and more</p>
            </div>

            <div class="features__card">
              <div class="features__top">
                <span class="material-symbols-outlined">code</span>
                <h3>Open Source</h3>
              </div>
              <p>100% open source under GPL-3.0 with zero telemetry or data harvesting.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- FAQ Section -->
      <section id="faq" class="faq">
        <div class="container">
          <div class="section-header-wrap">
            <h2>FAQ</h2>
          </div>

          <div class="faq__list">
            <details class="faq__card">
              <summary class="faq__question">
                <span>Is the app safe to use?</span>
                <span class="material-symbols-outlined faq__arrow">expand_more</span>
              </summary>
              <div class="faq__answer">
                <p>As all third-party clients and client mods do, using Lampcord is a violation of Discord ToS. With that being said, Lampcord does a best effort to mimick the official client, and there were no confirmed bans given for using unofficial clients.</p>
              </div>
            </details>

            <details class="faq__card">
              <summary class="faq__question">
                <span>Which platforms are supported?</span>
                <span class="material-symbols-outlined faq__arrow">expand_more</span>
              </summary>
              <div class="faq__answer">
                <p>Linux, Windows, macOS, Android, and iOS are all supported!</p>
              </div>
            </details>

            <details class="faq__card">
              <summary class="faq__question">
                <span>Will this have plugins?</span>
                <span class="material-symbols-outlined faq__arrow">expand_more</span>
              </summary>
              <div class="faq__answer">
                <p>There is no need for plugins. This is a client, meaning I can code things in directly without the need of plugins. If a feature is to be implemented, it will be a setting, not a plugin.</p>
              </div>
            </details>

            <details class="faq__card">
              <summary class="faq__question">
                <span>How can I support the project?</span>
                <span class="material-symbols-outlined faq__arrow">expand_more</span>
              </summary>
              <div class="faq__answer">
                <p>You can <a href="https://github.com/sponsors/l6t9" target="_blank" rel="noreferrer" class="faq__link">sponsor me on GitHub</a>. This will give you early access to test the alpha builds. You can also join our <a href="https://discord.gg/uHXJJzxSD8" target="_blank" rel="noreferrer" class="faq__link">Discord support server</a>.</p>
              </div>
            </details>
          </div>
        </div>
      </section>

      <!-- Downloads Section -->
      <section id="download" class="download">
        <div class="container">
          <div class="download__panel">
            <div class="download__copy">
              <h2>Downloads</h2>
              <p>Pre-built releases for Android, iOS, and Desktop.</p>
            </div>

            <div class="download__actions">
              <a href="https://github.com/l6t9/Lampcord/releases/latest" target="_blank" rel="noreferrer" class="btn btn-filled">
                <span class="material-symbols-outlined">download</span>
                GitHub Releases
              </a>
              <a href="https://apps.obtainium.imranr.dev/redirect?r=obtainium://add/https://github.com/l6t9/Lampcord/" target="_blank" rel="noreferrer" class="btn btn-outlined">
                <span class="material-symbols-outlined">install_mobile</span>
                Obtainium
              </a>
              <a href="https://discord.gg/uHXJJzxSD8" target="_blank" rel="noreferrer" class="btn btn-outlined">
                <span class="material-symbols-outlined">support_agent</span>
                Support Server
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="footer">
      <div class="container footer__inner">
        <div class="footer__brand">
          <span>Lampcord</span>
        </div>

        <div class="footer__links">
          <a href="https://github.com/l6t9/Lampcord" target="_blank" rel="noreferrer">GitHub</a>
          <a href="https://discord.gg/uHXJJzxSD8" target="_blank" rel="noreferrer">Discord</a>
          <a href="https://lampu.dev">lampu.dev</a>
          <button id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle light/dark mode" title="Toggle theme">
            <span class="material-symbols-outlined" id="theme-icon">dark_mode</span>
          </button>
        </div>
      </div>
    </footer>
  </div>

  <!-- Image Preview Lightbox Modal -->
  <div id="lightbox" class="lightbox" aria-hidden="true">
    <div class="lightbox__backdrop"></div>
    <div class="lightbox__content">
      <button id="lightbox-close" class="lightbox__btn lightbox__btn--close" aria-label="Close preview">
        <span class="material-symbols-outlined">close</span>
      </button>
      <button id="lightbox-prev" class="lightbox__btn lightbox__btn--prev" aria-label="Previous image">
        <span class="material-symbols-outlined">chevron_left</span>
      </button>
      <div class="lightbox__stage">
        <img id="lightbox-img" src="" alt="Enlarged preview" />
        <div id="lightbox-caption" class="lightbox__caption"></div>
      </div>
      <button id="lightbox-next" class="lightbox__btn lightbox__btn--next" aria-label="Next image">
        <span class="material-symbols-outlined">chevron_right</span>
      </button>
    </div>
  </div>
</BaseLayout>

<script>
  function initShowcaseTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.showcase__tab');
    const contents = document.querySelectorAll<HTMLElement>('[data-tab-content]');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetTab = tab.getAttribute('data-tab');
        if (!targetTab) return;

        tabs.forEach((t) => {
          const isActive = t === tab;
          t.classList.toggle('active', isActive);
          t.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        contents.forEach((content) => {
          const contentTab = content.getAttribute('data-tab-content');
          content.classList.toggle('active', contentTab === targetTab);
        });
      });
    });
  }

  function initLightbox() {
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxCaption = document.getElementById('lightbox-caption');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');
    const backdrop = document.querySelector('.lightbox__backdrop');

    if (!lightbox || !lightboxImg || !lightboxCaption) return;

    let currentImgs: HTMLImageElement[] = [];
    let currentIndex = 0;

    function updateLightbox() {
      const img = currentImgs[currentIndex];
      if (!img) return;
      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt;
      lightboxCaption!.textContent = `${img.alt} (${currentIndex + 1}/${currentImgs.length})`;
    }

    function openLightbox(index: number, imgs: HTMLImageElement[]) {
      currentImgs = imgs;
      currentIndex = index;
      updateLightbox();
      lightbox!.classList.add('active');
      lightbox!.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox!.classList.remove('active');
      lightbox!.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function showNext() {
      if (currentImgs.length === 0) return;
      currentIndex = (currentIndex + 1) % currentImgs.length;
      updateLightbox();
    }

    function showPrev() {
      if (currentImgs.length === 0) return;
      currentIndex = (currentIndex - 1 + currentImgs.length) % currentImgs.length;
      updateLightbox();
    }

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const screen = target.closest('.preview-tile__screen');
      if (screen) {
        const img = screen.querySelector<HTMLImageElement>('.screen-img');
        if (img) {
          const activeImgs = Array.from(
            document.querySelectorAll<HTMLImageElement>('.preview-tile__screen-wrap.active .screen-img')
          );
          const activeIdx = activeImgs.indexOf(img);
          if (activeIdx !== -1) {
            openLightbox(activeIdx, activeImgs);
          } else {
            const allImgs = Array.from(document.querySelectorAll<HTMLImageElement>('.screen-img'));
            openLightbox(allImgs.indexOf(img), allImgs);
          }
        }
      }
    });

    closeBtn?.addEventListener('click', closeLightbox);
    lightboxImg.addEventListener('click', closeLightbox);
    backdrop?.addEventListener('click', closeLightbox);
    nextBtn?.addEventListener('click', (e) => { e.stopPropagation(); showNext(); });
    prevBtn?.addEventListener('click', (e) => { e.stopPropagation(); showPrev(); });

    lightbox.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('.lightbox__btn--prev') || target.closest('.lightbox__btn--next')) {
        return;
      }
      closeLightbox();
    });

    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') showNext();
      if (e.key === 'ArrowLeft') showPrev();
    });
  }

  function initMobileMenu() {
    const toggleBtn = document.getElementById('menu-toggle') as HTMLButtonElement | null;
    const navMenu = document.getElementById('navbar-menu') as HTMLElement | null;
    const navbar = document.querySelector('.navbar') as HTMLElement | null;
    const toggleIcon = toggleBtn?.querySelector('.navbar__toggle-icon');

    if (!toggleBtn || !navMenu) return;

    function toggleMenu(open?: boolean) {
      const isExpanded = navMenu!.classList.contains('open');
      const shouldOpen = open ?? !isExpanded;

      navMenu!.classList.toggle('open', shouldOpen);
      navbar?.classList.toggle('menu-open', shouldOpen);
      toggleBtn!.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');

      if (toggleIcon) {
        toggleIcon.textContent = shouldOpen ? 'close' : 'menu';
      }
    }

    toggleBtn.addEventListener('click', () => toggleMenu());

    navMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        if (window.innerWidth <= 560) {
          toggleMenu(false);
        }
      });
    });
  }

  function initScrollHeader() {
    const navbar = document.querySelector('.navbar') as HTMLElement | null;
    if (!navbar) return;

    function handleScroll() {
      if (window.scrollY > 10) {
        navbar?.classList.add('scrolled');
      } else {
        navbar?.classList.remove('scrolled');
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }

  function init() {
    initShowcaseTabs();
    initLightbox();
    initMobileMenu();
    initScrollHeader();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>



<style>
  .metrosite-page {
    width: 100%;
    min-height: 100vh;
    background: var(--md-sys-color-background);
    color: var(--md-sys-color-on-background);
    font-family: 'Google Sans Flex', system-ui, -apple-system, sans-serif;
    position: relative;
    overflow-x: clip;
  }

  .metrosite-page button,
  .metrosite-page input,
  .metrosite-page select,
  .metrosite-page textarea {
    font-family: inherit;
  }

  .container {
    width: min(100% - 40px, 1100px);
    margin-inline: auto;
  }

  /* ═══ BUTTONS ═══ */
  .btn {
    border-radius: var(--m3e-radius-full);
    min-height: 42px;
    color: inherit;
    cursor: pointer;
    white-space: nowrap;
    border: 0;
    justify-content: center;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    display: inline-flex;
    transition: background 0.15s ease, transform 0.15s ease;
    max-width: 100%;
    box-sizing: border-box;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn-filled {
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
  }

  .btn-filled:hover {
    filter: brightness(1.08);
  }

  .btn-outlined {
    background: var(--md-sys-color-surface-container-high);
    color: var(--md-sys-color-primary);
  }

  .btn-outlined:hover {
    background: var(--md-sys-color-surface-container-highest);
  }

  .btn-sm {
    min-height: 36px;
    padding: 6px 14px;
    font-size: 0.85rem;
  }

  /* ═══ NAVBAR (Transparent at top, frosted glass on scroll) ═══ */
  .navbar {
    z-index: 100;
    background: transparent;
    position: sticky;
    top: 0;
    border-bottom: 1px solid transparent;
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
    transition: background 0.3s ease, backdrop-filter 0.3s ease, -webkit-backdrop-filter 0.3s ease, border-bottom-color 0.3s ease;
  }

  .navbar.scrolled,
  .navbar.menu-open {
    background: color-mix(in srgb, var(--md-sys-color-surface-container-low) 88%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom-color: color-mix(in srgb, var(--md-sys-color-outline-variant) 20%, transparent);
  }

  .navbar__inner {
    align-items: center;
    gap: 20px;
    min-height: 56px;
    display: flex;
    justify-content: space-between;
    transition: padding 0.3s ease;
  }

  .navbar__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    margin-right: auto;
  }

  .navbar__brand {
    color: var(--md-sys-color-on-surface);
